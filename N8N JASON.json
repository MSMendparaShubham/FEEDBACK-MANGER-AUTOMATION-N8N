      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const src = $('New Feedback Row').item.json;\nconst out = $json.output || {};\nreturn {\n  timestamp: src[\"Timestamp\"] || \"\",\n  name: src[\"Name ( Please enter your name correctly, as the same will be printed on the certificate.}\"] || \"\",\n  email: src[\"Collage Email ID \"] || \"\",\n  department: src[\"Department\"] || \"\",\n  favoritePart: src[\"What was your favorite part of the event ?\"] || \"\",\n  excitement: src[\"How much excited are you to participate in our upcoming events ?\"] || \"\",\n  oneWord: src[\"Any one word to describe your experience of Webinar ?\"] || \"\",\n  overallRating: src[\"How would you rate today's event overall?\"] ?? \"\",\n  engagementRating: src[\"Did you feel engaged and involved throughout the event ?\"] ?? \"\",\n  coordinationRating: src[\"How would you rate the event management and coordination?\"] ?? \"\",\n  improvements: src[\"Improvement you want to see in upcoming events?\"] || \"\",\n  sentiment: out.sentiment || \"\",\n  emotion: out.emotion || \"\",\n  key_insight: out.key_insight || \"\",\n  priority: out.priority || \"\",\n  recommendation: out.recommendation || \"\",\n  testimonial: out.testimonial || \"\",\n};"
      },
