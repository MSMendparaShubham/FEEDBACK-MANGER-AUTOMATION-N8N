        "jsCode": "const items = $input.all();\nlet rows = \"\";\nfor (const it of items) {\n  const j = it.json;\n  const quote = j.testimonial ? `<br/><i>&ldquo;${j.testimonial}&rdquo;</i>` : \"\";\n  rows += `<li><b>${j.name}</b> — ${j.key_insight}${quote}</li>`;\n}\nconst html = `<h2>Positive Reviews (${items.length})</h2><ul>${rows}</ul>`;\nreturn [{ json: { html, count: items.length } }];"
      },
